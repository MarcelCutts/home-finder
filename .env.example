# Home Finder Configuration
# Copy this file to .env and fill in your values
# All settings use the HOME_FINDER_ prefix

# Telegram Bot (Required for notifications)
# Create a bot via @BotFather on Telegram
HOME_FINDER_TELEGRAM_BOT_TOKEN=your-bot-token-here
HOME_FINDER_TELEGRAM_CHAT_ID=your-chat-id-here

# Telegram Webhook (Optional — enables inline button callbacks)
# Generate a random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# HOME_FINDER_TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# TravelTime API (Optional — enables commute filtering)
# Sign up at https://traveltime.com/
# HOME_FINDER_TRAVELTIME_APP_ID=your-app-id
# HOME_FINDER_TRAVELTIME_API_KEY=your-api-key

# Anthropic API (Optional — enables AI quality analysis)
# Get your API key at https://console.anthropic.com/
# HOME_FINDER_ANTHROPIC_API_KEY=your-api-key

# Feature Flags
# HOME_FINDER_ENABLE_QUALITY_FILTER=true
# HOME_FINDER_REQUIRE_FLOORPLAN=true
# HOME_FINDER_QUALITY_FILTER_MAX_IMAGES=20
# HOME_FINDER_ENABLE_EXTENDED_THINKING=true
# HOME_FINDER_ENABLE_IMAGE_HASH_MATCHING=true
# HOME_FINDER_MAX_ENRICHMENT_ATTEMPTS=3
# HOME_FINDER_MIN_GALLERY_FOR_PHOTO_INFERENCE=5
# HOME_FINDER_MAX_ANALYSIS_PER_RUN=75
# HOME_FINDER_QUALITY_CONCURRENCY=15
# HOME_FINDER_EVENT_RETENTION_RUNS=30

# Search Criteria
# HOME_FINDER_MIN_PRICE=1800
# HOME_FINDER_MAX_PRICE=2500
# HOME_FINDER_MIN_BEDROOMS=0
# HOME_FINDER_MAX_BEDROOMS=2
# HOME_FINDER_DESTINATION_POSTCODE=N1 5AA
# HOME_FINDER_MAX_COMMUTE_MINUTES=30
# HOME_FINDER_SEARCH_AREAS=e2,e3,e5,e9,e10,e15,e17,n15,n16,n17

# Scraper Filters
# HOME_FINDER_FURNISH_TYPES=unfurnished,part_furnished
# HOME_FINDER_MIN_BATHROOMS=1
# HOME_FINDER_INCLUDE_LET_AGREED=false
# HOME_FINDER_ZOOPLA_MAX_AREAS_PER_RUN=4

# Web Dashboard
# HOME_FINDER_WEB_BASE_URL=https://home-finder.fly.dev
# HOME_FINDER_WEB_PORT=8000
# HOME_FINDER_WEB_HOST=0.0.0.0
# HOME_FINDER_PIPELINE_INTERVAL_MINUTES=55

# Database
# HOME_FINDER_DATABASE_PATH=data/properties.db

# Proxy (for accessing geo-restricted sites from outside the UK)
# HOME_FINDER_PROXY_URL=socks5://user:pass@host:port

# Owner dashboard access (required when using --serve)
# Generate a random ASCII password with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Missing passwords or passwords shorter than 24 characters fail closed with HTTP 503.
HOME_FINDER_WEB_OWNER_USERNAME=owner
HOME_FINDER_WEB_OWNER_PASSWORD=
# Set HOME_FINDER_WEB_BASE_URL above to the canonical HTTPS origin when hosted.
# For private Telegram chats the owner defaults to TELEGRAM_CHAT_ID.
# Group chats require the owner's numeric user ID explicitly:
# HOME_FINDER_TELEGRAM_OWNER_USER_ID=123456789

# Paid analysis stays disabled unless exact USD caps are explicitly configured.
# This example authorizes ZERO spend; select personal caps before enabling.
# HOME_FINDER_ANALYSIS_SPEND_POLICY={"per_call_usd":"0","daily_usd":"0","monthly_usd":"0","max_in_flight":1,"max_attempts_per_operation":2}
# With ANALYSIS_CONFIG absent, new runs use Sonnet 5.5, low effort, 8192 output
# tokens and zero SDK retries. The gallery default stays 20. At 20 images,
# reservations are $0.98392 visual / $0.64192 evaluation per attempt.
# The visual input allowance scales with QUALITY_FILTER_MAX_IMAGES; oversized
# text/image payloads still defer. No API key or default model authorizes spend.
# Partial JSON overrides the current runtime profile; {} keeps the same defaults.
# Top-level null is rejected; disable quality analysis with ENABLE_QUALITY_FILTER=false.
# To pin the current 20-image runtime profile (see docs/operations.md):
# HOME_FINDER_ANALYSIS_CONFIG={"version":1,"visual":{"model":"claude-sonnet-5-5","reasoning":"adaptive","effort":"low","input_token_limit":225500,"max_output_tokens":8192,"sdk_retries":0},"evaluation":{"model":"claude-sonnet-5-5","reasoning":"disabled","effort":"low","input_token_limit":140000,"max_output_tokens":8192,"sdk_retries":0}}
# To change only visual effort while retaining bounded modern defaults:
# HOME_FINDER_ANALYSIS_CONFIG={"visual":{"effort":"medium"}}
