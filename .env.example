# Home Finder: copy to .env in the directory where you run home-finder.
# Check locally with: uv run home-finder --check-config
# Or select a file explicitly: uv run home-finder --env-file /path/to/.env --check-config
# Process environment overrides .env; omitted settings use the defaults below.
# This file parses as-is. Optional integrations stay unavailable until configured.
# Keep one assignment per key. Comment out optional numeric/JSON settings to unset
# them: an empty assignment is a value, not a request to use the default.
# All application settings use HOME_FINDER_. Never commit a filled .env.

# Owner dashboard (--serve; collection is off unless --with-pipeline is passed)
# Generate a 24+ character ASCII password:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# An empty, short or non-ASCII password denies dashboard access with HTTP 503.
HOME_FINDER_WEB_OWNER_PASSWORD=
# HOME_FINDER_WEB_OWNER_USERNAME=owner
# Canonical HTTP(S) origin, without a path/query/credentials; HTTPS when hosted.
# Example: https://home-finder.fly.dev (leave empty for local request-origin checks).
# HOME_FINDER_WEB_BASE_URL=
# HOME_FINDER_WEB_HOST=0.0.0.0
# HOME_FINDER_WEB_PORT=8000
# Optional CARTO basemap key: visible in the browser, restrict allowed origins.
# Without it, grid browsing works but maps are unavailable.
# HOME_FINDER_CARTO_BASEMAP_API_KEY=

# Telegram delivery (required for the normal pipeline and --serve --with-pipeline)
# Other modes need no Telegram credentials. --dry-run collects without delivery,
# but can still spend on configured analysis. Both token and nonzero chat ID are needed.
# Create a bot via @BotFather. Negative IDs are valid for groups.
# HOME_FINDER_TELEGRAM_BOT_TOKEN=
# HOME_FINDER_TELEGRAM_CHAT_ID=0
# Callbacks additionally need the bot/chat, HTTPS WEB_BASE_URL and a webhook secret.
# Generate the secret with secrets.token_urlsafe(32), as for the password above.
# HOME_FINDER_TELEGRAM_WEBHOOK_SECRET=
# Private chats default the owner to the positive chat ID. For groups, set the
# owner's positive numeric user ID; this example is not a default:
# HOME_FINDER_TELEGRAM_OWNER_USER_ID=123456789
# Discovery alerts require a rated assessment meeting this cutoff.
# Price updates use prior discovery or explicit tracking independently.
# HOME_FINDER_NOTIFICATION_POLICY={"min_fit_score":60}

# TravelTime (optional advisory measurements; both fields are required)
# Sign up at https://traveltime.com/. Missing credentials leave commute unknown.
# HOME_FINDER_TRAVELTIME_APP_ID=
# HOME_FINDER_TRAVELTIME_API_KEY=

# Search preferences (rent is monthly GBP; bedrooms=0 includes studios)
# HOME_FINDER_MIN_PRICE=1800
# HOME_FINDER_MAX_PRICE=2500
# HOME_FINDER_MIN_BEDROOMS=0
# HOME_FINDER_MAX_BEDROOMS=2
# HOME_FINDER_DESTINATION_POSTCODE=N1 5AA
# HOME_FINDER_MAX_COMMUTE_MINUTES=30
# Comma-separated outcodes or supported borough names. Empty means no search areas.
# HOME_FINDER_SEARCH_AREAS=e2,e3,e5,e8,e9,e10,e15,e17,n1,n5,n15,n16,n17
# Dashboard brief only: weak must-haves lead the listing summary; this does not
# change assessment prompts, fit weights or notification selection.
# Options: workspace, hosting, sound, kitchen, vibe, condition. Empty means none.
# Rent, bedrooms and commute are always must-haves in the brief.
# HOME_FINDER_BRIEF_MUST_HAVES=workspace,hosting
# Source search hints, not guaranteed constraints; empty furnishing means any.
# Zoopla ignores all three. OpenRent passes browser filter state without local
# enforcement. OnTheMarket supports one furnishing value and no bathroom filter.
# Rightmove forwards all three. See README for source-filter limitations.
# HOME_FINDER_FURNISH_TYPES=unfurnished,part_furnished
# HOME_FINDER_MIN_BATHROOMS=1
# HOME_FINDER_INCLUDE_LET_AGREED=false

# AI assessment (optional: key + enabled flag + explicit spend caps are required)
# Get a key at https://console.anthropic.com/. The app does not use ANTHROPIC_API_KEY.
# HOME_FINDER_ANTHROPIC_API_KEY=
# HOME_FINDER_ENABLE_QUALITY_FILTER=true
# ZERO spend example: choose personal caps before enabling paid requests.
# Amounts must be exact decimal strings, ordered per_call <= daily <= monthly.
# HOME_FINDER_ANALYSIS_SPEND_POLICY={"per_call_usd":"0","daily_usd":"0","monthly_usd":"0","max_in_flight":1,"max_attempts_per_operation":2}
# Omit ANALYSIS_CONFIG to follow the current bounded runtime profile; {} does too.
# Partial phase JSON overrides it (e.g. {"visual":{"effort":"medium"}}).
# Explicit phase reasoning overrides ENABLE_EXTENDED_THINKING. Top-level null is invalid.
# See docs/operations.md#runtime-model-defaults for profiles, bounds and spend semantics.
# HOME_FINDER_ANALYSIS_CONFIG={}
# HOME_FINDER_ENABLE_EXTENDED_THINKING=true

# Advanced tuning: most installations should leave this section commented out.
# Gallery acquisition and analysis limit (1-20); input allowance scales with it.
# HOME_FINDER_QUALITY_FILTER_MAX_IMAGES=20
# Assessment admission accepts a source-declared floorplan, an exempt source or
# enough gallery photos. This is not an unconditional drop of every floorplan-less home.
# HOME_FINDER_REQUIRE_FLOORPLAN=true
# Minimum gallery count to bypass the gate; 0 disables the photo bypass.
# HOME_FINDER_MIN_GALLERY_FOR_PHOTO_INFERENCE=5
# Independent initial and reassessment queue caps (1-500 each, not a combined cap).
# HOME_FINDER_MAX_INITIAL_ANALYSES_PER_RUN=75
# HOME_FINDER_MAX_REANALYSES_PER_RUN=75
# Compatibility fallback for each unset queue cap. Prefer the explicit caps above.
# HOME_FINDER_MAX_ANALYSIS_PER_RUN=75
# Effective concurrency is also capped by ANALYSIS_SPEND_POLICY.max_in_flight.
# HOME_FINDER_QUALITY_CONCURRENCY=15
# Per-property wall-clock timeout in seconds (30-900), across analysis phases/retries.
# HOME_FINDER_PROPERTY_ANALYSIS_TIMEOUT=600
# Recovery and discovery share enrichment slots (1-500); attempts are bounded (1-10).
# HOME_FINDER_MAX_ENRICHMENT_PER_RUN=75
# HOME_FINDER_MAX_ENRICHMENT_ATTEMPTS=3
# HOME_FINDER_ENABLE_IMAGE_HASH_MATCHING=true
# Keep diagnostic property events for this many pipeline runs (not days).
# HOME_FINDER_EVENT_RETENTION_RUNS=30
# Rotate a subset of Zoopla areas per run (1-20).
# HOME_FINDER_ZOOPLA_MAX_AREAS_PER_RUN=4
# Proxy for OpenRent/Zoopla/OnTheMarket search, curl-based media/detail fetching
# and off-market checks. Not a global proxy for Rightmove search or other APIs.
# Example: socks5://user:pass@host:port (percent-encode special characters in credentials).
# HOME_FINDER_PROXY_URL=

# Runtime/storage
# Relative database and image-cache paths resolve from the current working directory,
# even with --env-file. Use an absolute path when sharing one authoritative database.
# HOME_FINDER_DATABASE_PATH=data/properties.db
# Only --serve --with-pipeline uses this delay: after completion, plus 0-5 min jitter.
# One-shot commands and cron do not use it. SCRAPE_INTERVAL_MINUTES is unsupported.
# HOME_FINDER_PIPELINE_INTERVAL_MINUTES=55
